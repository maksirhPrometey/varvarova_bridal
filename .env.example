SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.develop

# Local SQLite by default (develop). For Postgres locally / Docker:
# POSTGRES_DB=bridal
# POSTGRES_USER=bridal
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# LiqPay (порожньо = оплата карткою вимкнена, лишається рахунок)
# LIQPAY_PUBLIC_KEY=
# LIQPAY_PRIVATE_KEY=
# LIQPAY_SERVER_URL=
# LIQPAY_SANDBOX=True

# Production
# DJANGO_SETTINGS_MODULE=config.settings.production
# ALLOWED_HOSTS=example.com,www.example.com
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# SECURE_SSL_REDIRECT=True
